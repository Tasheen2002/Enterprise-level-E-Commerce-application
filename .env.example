# Local values only. Never commit real credentials.
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:local_password@localhost:5432/slipperze_dev
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000,http://localhost:3002
RATE_LIMIT_MAX=5000
RATE_LIMIT_TIMEWINDOW=1m
# Set exact trusted proxy addresses/CIDRs only when a reverse proxy is used.
# TRUST_PROXY=127.0.0.1
# Database tests are destructive and require BOTH settings below.
# TEST_DATABASE_URL=postgresql://test:test@localhost:5432/slipperze_test
# ALLOW_DATABASE_TEST_CLEANUP=1
# TEST_DATABASE_HOST=localhost
# FEDEX_API_KEY=
# FEDEX_SECRET_KEY=
# FEDEX_ACCOUNT_NUMBER=
# FEDEX_URL=https://apis-sandbox.fedex.com
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
