# Local values only. Never commit real credentials.
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:local_password@localhost:5432/slipperze_dev
# Production requires at least 32 bytes (HS256 key size).
JWT_SECRET=replace-with-a-long-random-secret
# Refresh-token (session) lifetime; access tokens are fixed at 15 minutes.
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000,http://localhost:3002
RATE_LIMIT_MAX=5000
RATE_LIMIT_TIMEWINDOW=1m
# Set exact trusted proxy addresses/CIDRs (or loopback, linklocal, uniquelocal)
# only when a reverse proxy is used. Hop counts such as 1 and "true" are rejected.
# TRUST_PROXY=127.0.0.1
# API docs at /docs default to on outside production and off in production.
# API_DOCS_ENABLED=false
# Database tests are destructive and require BOTH settings below.
# TEST_DATABASE_URL=postgresql://test:test@localhost:5432/slipperze_test
# ALLOW_DATABASE_TEST_CLEANUP=1
# TEST_DATABASE_HOST=localhost
# Optional providers: leave unset to disable. Blank values are rejected;
# paired keys (ImageKit, FedEx, Firebase Admin) must be configured together.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_CURRENCY=usd
# PAYPAL_WEBHOOK_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# IMAGEKIT_PUBLIC_KEY=
# IMAGEKIT_PRIVATE_KEY=
# Warehouse location UUID used for stock movements.
# DEFAULT_STOCK_LOCATION=
# FEDEX_API_KEY=
# FEDEX_SECRET_KEY=
# FEDEX_ACCOUNT_NUMBER=
# FEDEX_URL=https://apis-sandbox.fedex.com
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
