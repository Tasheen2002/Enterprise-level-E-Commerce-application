{
  "name": "@tasheen/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "Auto-generated SDK for the Tasheen Fastify backend. Regenerate offline from registered routes via `pnpm run generate:api-client`.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "pnpm -w run generate:api-client",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "^0.12.2",
    "@tasheen/types": "workspace:*"
  },
  "devDependencies": {
    "@tasheen/config": "workspace:*",
    "openapi-typescript": "^7.4.4",
    "typescript": "^5.9.3"
  }
}
