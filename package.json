{
  "name": "tasheen-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Slipperze — enterprise-level e-commerce monorepo (backend + storefront + admin).",
  "type": "commonjs",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npx tsx watch apps/api/src/index.ts",
    "start:api": "npx tsx apps/api/src/index.ts",
    "dev:web": "turbo run dev --filter=@tasheen/web",
    "dev:admin": "turbo run dev --filter=@tasheen/admin",
    "dev": "turbo run dev --parallel",
    "build": "pnpm run type-check:api && turbo run build",
    "build:api": "npx tsc --noEmit",
    "lint": "pnpm run lint:api && turbo run lint",
    "lint:api": "eslint --no-eslintrc --config .eslintrc.backend.cjs --ext .ts apps/api modules packages/core/src packages/types/src packages/validation/src scripts",
    "format:check": "prettier --check apps/api/src/shared apps/api/src/plugins packages/core/src packages/types/src packages/validation/src scripts/testing",
    "type-check": "pnpm run type-check:api && turbo run type-check",
    "type-check:api": "tsc --noEmit",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run --exclude \"**/test/integration/**\" --exclude \"**/test/e2e/**\"",
    "test:coverage": "pnpm run test:unit --coverage",
    "test:vitest": "vitest run",
    "test:vitest:watch": "vitest",
    "clean": "turbo run clean",
    "api:check": "npx tsc --noEmit --ignoreDeprecations 5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tasheen2002/Enterprise-level-E-Commerce-application.git"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Tasheen2002/Enterprise-level-E-Commerce-application/issues"
  },
  "homepage": "https://github.com/Tasheen2002/Enterprise-level-E-Commerce-application#readme",
  "devDependencies": {
    "@prisma/client": "^6.16.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.0.3",
    "@types/nodemailer": "^8.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/sanitize-html": "^2.16.1",
    "@types/speakeasy": "^2.0.10",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "8.59.1",
    "@typescript-eslint/parser": "8.59.1",
    "@vitest/coverage-v8": "4.1.5",
    "eslint": "8.57.1",
    "prettier": "3.6.2",
    "prisma": "^6.16.1",
    "tsx": "^4.21.0",
    "turbo": "^2.9.16",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "firebase-admin": "^13.9.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^8.0.7",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "sanitize-html": "^2.17.3",
    "speakeasy": "^2.0.0",
    "stripe": "^20.4.0",
    "uuid": "^13.0.0",
    "zod": "^4.3.5"
  },
  "packageManager": "pnpm@9.12.0"
}
